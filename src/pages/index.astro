---
import Layout from '../layouts/Layout.astro';
import {
		AirplaneTiltIcon,
		BookOpenTextIcon,
		BowlFoodIcon,
		BowlSteamIcon,
		HandshakeIcon,
		HeadCircuitIcon,
		PhoneOutgoingIcon,
		SparkleIcon,
} from '@phosphor-icons/react';

// Import all sections
const heroContent = await import('../content/sections/hero.md');
const aboutContent = await import('../content/sections/about.md');
const servicesContent = await import('../content/sections/services.md');

const hero = heroContent.frontmatter;
const about = aboutContent.frontmatter;
const services = servicesContent.frontmatter;

const footerContent = await import('../content/sections/footer.md');
const contactContent = await import('../content/sections/contact.md');
const navContent = await import('../content/navigation/main.md');

const footer = footerContent.frontmatter;
const contact = contactContent.frontmatter;
const navigation = navContent.frontmatter;
const serviceIcons = {
	AirplaneTiltIcon,
	BookOpenTextIcon,
	HandshakeIcon,
	HeadCircuitIcon,
	SparkleIcon,
};
---

<Layout title={hero.title}>

	<section id="about" class="reveal constrain">
		<!-- About Section -->
		<section class="body-section about">
			<div class="body-section-title">
				<h2>{about.title}</h2>
			</div>
			<div class="flex-section-center border">
				<img class="body-section-image" src={about.image} />
				<div class="body-section-text border">
						<aboutContent.Content />
				</div>
			</div>
		</section>
		</section>

		<div class="section-divider constrain" aria-hidden="true">
			<hr />
			<BowlFoodIcon size={36} weight="regular" />
			<hr />
		</div>

		<section id="services" class="reveal constrain">
		<!-- Services Section -->
		<section class="body-section services">
			<div class="body-section-title">
				<h2>{services.title}</h2>
			</div>
			<div class="flex-section-center">
				<div class="body-section-text border">
					<p>{services.overview}</p>
					<p>{services.contact_line}</p>
				</div>
			</div>
				<div class="desc-list-section">
					<ul class="desc-list">
						{services.service_area.map(item => {
							const Icon = serviceIcons[item.icon];
							return (
								<li class="service-area-item">
									{Icon && <Icon size={72} />}
									<span>{item.text}</span>
								</li>
							);
						})}
					</ul>
				</div>
			</section>
		</section>

		<div class="section-divider constrain" aria-hidden="true">
			<hr />
			<BowlSteamIcon size={36} weight="regular" />
			<hr />
		</div>

	</Layout>
